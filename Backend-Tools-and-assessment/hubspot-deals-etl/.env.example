# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production-hubspot-deals
PORT=5200
HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hubspot_data
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SCHEMA=hubspot_deals

# DLT Configuration
DLT_PIPELINE_NAME=hubspot_deals
DLT_WORKING_DIR=.dlt
DLT_RUNTIME_ENV=development

# HubSpot API Configuration
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_ACCESS_TOKEN=pat-na1-your-private-app-token-here
HUBSPOT_API_TIMEOUT=30
HUBSPOT_API_RATE_LIMIT=100
HUBSPOT_DEALS_ENDPOINT=/crm/v3/objects/deals
HUBSPOT_PROPERTIES_ENDPOINT=/crm/v3/properties/deals

# Service Configuration
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT_HOURS=24
CLEANUP_DAYS=7
DEFAULT_BATCH_SIZE=100

# Logging Configuration
LOG_LEVEL=INFO
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=